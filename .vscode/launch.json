    "version": "0.2.0",
    "configurations": [
        {
            "name": "BleachBit",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/bleachbit_loader/main.py",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
        },
        {
            "name": "Main",
            "python": "${workspaceFolder}/bleachbit_venv/bin/python.exe",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/bleachbit_loader/impl.py",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/bleachbit_loader"
            },
        }
    ]
}